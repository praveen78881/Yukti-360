# Copy this file to ".env" and fill in real values.
# .env is gitignored — NEVER commit real keys. Leave a value EMPTY to stay in offline mode.
# After editing, restart the dev server: npm run dev

# ── Supabase (enables real auth incl. Google sign-in) ───────────────────────
# Supabase → Project Settings → API
#   VITE_SUPABASE_URL      = Project URL (https://xxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = the "anon" / public (publishable) key — safe for the client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only — do NOT prefix with VITE_ (keep out of the client bundle)
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (AI assistant "Aleza") ───────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
# Server-side key used by the Netlify proxy (netlify/functions/gemini-plan.js).
# On Netlify, set GEMINI_API_KEY under Site settings → Environment variables.
GEMINI_API_KEY=
# (Client-side Gemini key removed — all AI calls go through the server proxy.)

# VITE_GEMINI_API_KEY removed — the client no longer calls Gemini directly.
# The single model the app uses. No fallbacks — leave VITE_GEMINI_FALLBACK_MODELS empty.
VITE_GEMINI_MODEL=gemini-3-flash-preview
VITE_GEMINI_FALLBACK_MODELS=

# ── Optional: licensed MCA company-data provider (CIN auto-fill on Create Company) ──
VITE_MCA_API_URL=
VITE_MCA_API_KEY=

# ── Sandbox.co.in (GST GSP — GSTR-2A/2B download, GSTR-1/3B/9 filing) ──
# Server-only — do NOT prefix with VITE_ (kept out of the client bundle). Used by
# netlify/functions/gst-sandbox.js and its Vite dev mirror. The key/secret are
# host-bound: a test key on the prod host (or vice-versa) returns 403.
#   Production:  SANDBOX_HOST=api.sandbox.co.in      + key_live_.../secret_live_...
#   Test:        SANDBOX_HOST=test-api.sandbox.co.in + key_test_.../secret_test_...
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_HOST=api.sandbox.co.in
SANDBOX_API_VERSION=1.0.0

# ── Income-Tax ERI (ITR filing via the ITD portal) ──
# Server-only. The app key/secret above authenticate Validate & Submit; these ERI
# user credentials additionally authorise the taxpayer-scoped reads (prefill,
# e-verify, ITR-V). Get them from your Sandbox ERI registration (user id like
# ERIP000325). Env-specific overrides win over the generic pair, mirroring the keys.
SANDBOX_ERI_USER_ID=
SANDBOX_ERI_PASSWORD=
# SANDBOX_ERI_LIVE_USER_ID=
# SANDBOX_ERI_LIVE_PASSWORD=
# SANDBOX_ERI_TEST_USER_ID=
# SANDBOX_ERI_TEST_PASSWORD=
