{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"type": "object",
	"properties": {
			"ewbNo": {
					"type": "number",
					"maxLength": 12,
					"minLength": 12,
					"description": "Ewaybill Number"
			},
			"groupNo": {
					"type": "string",
					"description": "Group Number"
			},
			"vehicleNo": {
					"type": "string",
					"minLength": 7,
					"maxLength": 15,
					"description": "Vehicle Number"
			},
			"transDocNo": {
					"type": "string",
					"maxLength": 15,
					"description": "Transport Document Number"
			},
			"transDocDate": {
					"type": "string",
					"pattern": "[0-3][0-9]/[0-1][0-9]/[2][0][1-2][0-9]",
					"description": "Transport Document Date"
			},
			"quantity": {
					"type": "number",
					"description": "Quantity"
			}
	},
	"required": [
			"ewbNo",
			"groupNo",
			"vehicleNo",
			"transDocNo",
			"transDocDate",
			"quantity"
	]
}