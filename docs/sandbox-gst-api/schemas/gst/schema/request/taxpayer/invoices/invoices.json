    "definitions": {
        "gstin": {
            "type": "string",
            "maxLength": 15,
            "minLength": 15,
            "pattern": "[0-9]{2}[a-zA-Z]{5}[0-9]{4}[a-zA-Z]{1}[1-9A-Za-z]{1}[Zz1-9A-Ja-j]{1}[0-9a-zA-Z]{1}"
        },
        "rtnprd": {
            "type": "string",
            "pattern": "^((0[1-9]|1[012])((19|20)\\d\\d))$"
        },
        "r1formtype": {
            "type": "string",
            "enum": [
                "R1",
                "R1A",
                "IFF"
            ]
        },
        "inum": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^(?=.{1,16}$)([/\\-0]*[a-zA-Z0-9/\\-]*[a-zA-Z1-9]+[a-zA-Z0-9/\\-]*)$"
        },
        "idt": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(0[1-9]|1[0-9]|2[0-8]|29((?=-([0][13-9]|1[0-2])|(?=-(0[1-9]|1[0-2])-([0-9]{2}(0[48]|[13579][26]|[2468][048])|([02468][048]|[13579][26])00))))|30(?=-(0[13-9]|1[0-2]))|31(?=-(0[13578]|1[02])))-(0[1-9]|1[0-2])-[0-9]{4}$"
        },
        "inv_typ": {
            "type": "string",
            "enum": [
                "R",
                "DE",
                "SEWP",
                "SEWOP",
                "CBW"
            ]
        },
        "pos": {
            "type": "string",
            "pattern": "^(3[0-8]|[12][0-9]|0[1-9]|96|97)$",
            "maxLength": 2,
            "minLength": 2
        },
        "val": {
            "type": "number",
            "multipleOf": 0.01,
            "maximum": 9999999999999.99,
            "minimum": 0
        },
        "amts": {
            "type": "number",
            "multipleOf": 0.01,
            "maximum": 99999999999.99,
            "minimum": 0
        },
        "all_action": {
            "type": "string",
            "enum": [
                "A",
                "R",
                "P",
                "N"
