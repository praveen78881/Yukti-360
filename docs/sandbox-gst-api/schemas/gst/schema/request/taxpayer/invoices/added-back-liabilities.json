{
    "title": "IMS - Get Added Back Liability Records Response Schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "gstin",
        "rtnprd",
        "rejInvAddBackLiab"
    ],
    "properties": {
        "gstin": {
            "$ref": "#/definitions/gstin",
            "description": "GSTIN of the taxpayer"
        },
        "rtnprd": {
            "$ref": "#/definitions/monthYearFormat",
            "description": "Return period in MMYYYY format"
        },
        "rejInvAddBackLiab": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cdnr": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/cdnrItem"
                    }
                },
                "b2ba": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/b2baItem"
                    }
                },
                "cdnra": {
                    "type": "array",
