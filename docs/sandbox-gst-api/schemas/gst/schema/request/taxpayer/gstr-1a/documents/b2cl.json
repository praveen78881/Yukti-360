{
  "id": "Get-B2CL-Schema",
  "properties": {
    "b2cl": {
      "items": {
        "properties": {
          "inv": {
            "items": {
              "properties": {
                "chksum": {
                  "maxLength": 64,
                  "description": "Invoice checksum",
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9]+$",
                  "minLength": 1
                },
                "etin": {
                  "description": "Ecom Gstin",
                  "type": "string",
                  "maxLength": 15,
                  "minLength": 15,
                  "pattern": "^[a-zA-Z0-9._\\s]+$"
                },
                "idt": {
                  "description": "Supplier Invoice Date",
                  "type": "string",
                  "pattern": "^((0[1-9]|[12][0-9]|3[01])[-](0[1-9]|1[012])[-]((19|20)\\d\\d))$"
                },
                "inum": {
                  "maxLength": 16,
                  "description": "Supplier Invoice Number",
                  "type": "string"
                },
				"inv_typ":{
						"description":"tax payer action",
						"type":"string",
						"enum":[
								"CBW"
							]
					},
				"diff_percent":{
                                 "description":"Differential percentage",
								 "type":"number",
								 "multipleOf": 0.01								 
								 }, 
                "itms": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "itm_det": {
                        "additionalProperties": false,
                        "properties": {
                          "rt": {
                            "description": "rate as per invoice",
                            "type": "number"
                          },
                          "iamt": {
                            "description": "IGST Amount as per invoice",
                            "type": "number"
                          },
                          "csamt":{
                             "description": "Cess Amount as per invoice",
                            "type": "number"
                          },
                          "camt": {
                            "description": "CGST Amount as per invoice",
                            "type": "number"
                          },
                          "samt": {
                           "description": "SGST Amount as per invoice",
                           "type": "number"
                         },
                          "txval": {
                            "description": "Taxable value of Goods or Service as per invoice",
                            "type": "number",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "rt",
                          "txval"
                        ],
                        "type": "object"
                      },
                      "num": {
                        "description": "Serial no",
                        "type": "number",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "itm_det",
                      "num"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "val": {
                  "type": "number"
                }
              },
              "required": [
                "val",
                "idt",
                "inum",
                "chksum",
                "itms"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "pos": {
            "description": "Actual Place of Supply",
            "maxLength": 2,
            "minLength": 2,
            "type": "string",
			"pattern": "^(3[0-8]|[12][0-9]|0[1-9]|97)$"
          }
          
        },
        "required": [
          "inv",
          "pos"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "b2cl"
  ],
  "type": "object"
}