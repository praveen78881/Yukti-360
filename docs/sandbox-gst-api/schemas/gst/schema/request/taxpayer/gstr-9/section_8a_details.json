  "required": [
    "gstin",
    "fy"
  ],
  "definitions": {
    "gstin": {
      "maxLength": 15,
      "minLength": 15,
      "pattern": "([0-9]{2}[a-zA-Z]{5}[0-9]{4}[a-zA-Z]{1}[1-9A-Za-z]{1}[Zz1-9A-Ja-j]{1}[0-9a-zA-Z]{1})|([0-9]{4}[a-zA-Z]{3}[0-9]{5}[N][R][0-9a-zA-Z]{1})",
      "type": "string"
    },
    "rtnPrd": {
      "minLength": 1,
      "pattern": "^((0[1-9]|1[012])((19|20)\\d\\d))$",
      "type": "string"
    },
    "dt": {
      "minLength": 1,
      "pattern": "^(0[1-9]|1[0-9]|2[0-8]|29((?=-([0][13-9]|1[0-2])|(?=-(0[1-9]|1[0-2])-([0-9]{2}(0[48]|[13579][26]|[2468][048])|([02468][048]|[13579][26])00))))|30(?=-(0[13-9]|1[0-2]))|31(?=-(0[13578]|1[02])))-(0[1-9]|1[0-2])-[0-9]{4}$",
      "type": "string"
    },
    "iseligible": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ]
    },
    "reason": {
      "type": "string"
    },
    "fy": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7
    },
    "docid": {
      "description": "JSON file id",
      "type": "number",
      "minLength": 1
    },
    "inum": {
      "type": "string",
      "maxLength": 16
    },
    "idt": {
      "description": "Supplier Invoice Date",
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])[-](0[1-9]|1[012])[-](19|20)[0-9][0-9]$"
    },
    "filingdt": {
      "description": "Supplier Filing Date",
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])[-](0[1-9]|1[012])[-](19|20)[0-9][0-9]$"
    },
    "val": {
      "type": "number",
      "multipleOf": 0.01,
      "maximum": 9999999999999.99,
      "minimum": 0
    },
    "nonEmptyCost": {
      "type": "number",
      "multipleOf": 0.01,
      "maximum": 99999999999.99,
      "minimum": 0
    },
    "pos": {
      "description": "Actual Place of Supply",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
    },
    "rchrg": {
      "description": "Reverse Charge",
      "type": "string",
      "enum": [
        "Y",
        "N"
      ]
    },
    "invtyp": {
      "description": " Invoice Type",
      "type": "string",
      "enum": [
        "R",
        "DE",
        "SEWP",
        "SEWOP",
        "CBW"
      ]
    },
    "num": {
      "description": "Serial no",
      "type": "number",
      "minLength": 1
    },
    "nt_dt": {
      "description": "Credit Note/Debit Note/  Refund Voucher date",
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])[-](0[1-9]|1[012])[-](19|20)[0-9][0-9]$"
    },
    "nt_num": {
      "minLength": 1,
      "maxLength": 16,
      "description": "Credit note/debit note / Refund Voucher Number",
      "type": "string"
    },
    "ntty": {
      "description": "Credit/debit note type/ Refund Voucher",
      "type": "string",
      "enum": [
        "C",
        "D"
      ]
    }
  }
}